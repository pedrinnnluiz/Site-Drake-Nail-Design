/* =========================================================
   Marcelo Nail Design — estilos
   Para mudar cores ou fontes, edite apenas as variáveis abaixo.
   ========================================================= */

:root {
  /* Cores da marca */
  --preto: #171416;
  --vinho: #571d32;
  --vinho-escuro: #3f1424;
  --off-white: #f3eee7;
  --champagne: #d7c0a0;
  --cinza: #a69da0;

  --texto-claro-suave: #c9c0bf;
  --texto-escuro-suave: #5d5458;
  --linha-clara: rgba(243, 238, 231, 0.16);
  --linha-escura: rgba(23, 20, 22, 0.14);

  /* Fontes */
  /* Uma única família sem serifa; a hierarquia vem do peso e do tamanho */
  --fonte-titulo: 'Plus Jakarta Sans', 'Helvetica Neue', Arial, sans-serif;
  --fonte-texto: 'Plus Jakarta Sans', 'Helvetica Neue', Arial, sans-serif;

  /* Tamanhos */
  --titulo-gigante: clamp(2.6rem, 1.4rem + 5.2vw, 5.6rem);
  --titulo-grande: clamp(2.1rem, 1.4rem + 3vw, 3.5rem);
  --titulo-medio: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
  --texto-grande: 1.25rem;

  --espaco-secao: clamp(4.5rem, 3rem + 6vw, 8.5rem);
  --margem: clamp(1rem, 0.5rem + 2.5vw, 2.5rem);
  --largura-max: 1240px;
  --altura-cabecalho: 76px;

  /* O arco remete ao formato amendoado da unha */
  --arco: 999px 999px 18px 18px;
  --transicao: 280ms cubic-bezier(0.22, 1, 0.36, 1);
}

/* ---------- Base ---------- */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

body {
  margin: 0;
  font-family: var(--fonte-texto);
  font-size: 1.0625rem;
  line-height: 1.6;
  color: var(--preto);
  background: var(--off-white);
  -webkit-font-smoothing: antialiased;
}

body.sem-rolagem {
  overflow: hidden;
}

img {
  display: block;
  max-width: 100%;
  height: auto;
}

h1,
h2,
h3 {
  margin: 0;
  font-family: var(--fonte-titulo);
  font-weight: 600;
  line-height: 1.08;
  letter-spacing: -0.03em;
  text-wrap: balance;
}

p {
  margin: 0;
}

a {
  color: inherit;
}

button {
  font: inherit;
  color: inherit;
}

:focus-visible {
  outline: 2px solid var(--champagne);
  outline-offset: 3px;
}

::selection {
  background: var(--vinho);
  color: var(--off-white);
}

.container {
  width: 100%;
  max-width: var(--largura-max);
  margin-inline: auto;
  padding-inline: var(--margem);
}

.so-leitor-de-tela {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}

.pular-conteudo {
  position: absolute;
  top: -100px;
  left: var(--margem);
  z-index: 300;
  padding: 0.75rem 1.25rem;
  background: var(--off-white);
  color: var(--preto);
  font-weight: 600;
  border-radius: 6px;
  text-decoration: none;
}

.pular-conteudo:focus {
  top: 12px;
}

/* ---------- Botões ---------- */

.botao {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  min-height: 52px;
  padding: 0.85rem 1.6rem;
  border: 1px solid transparent;
  border-radius: 999px;
  font-size: 0.975rem;
  font-weight: 600;
  text-decoration: none;
  white-space: nowrap;
  transition: background-color var(--transicao), color var(--transicao), border-color var(--transicao);
}

.botao svg {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
}

.botao-vinho {
  background: var(--vinho);
  color: var(--off-white);
}
.botao-vinho:hover {
  background: var(--vinho-escuro);
}

.botao-claro {
  background: var(--off-white);
  color: var(--preto);
}
.botao-claro:hover {
  background: var(--champagne);
}

.botao-contorno-claro {
  border-color: rgba(243, 238, 231, 0.45);
  color: var(--off-white);
}
.botao-contorno-claro:hover {
  border-color: var(--champagne);
  color: var(--champagne);
}

.botao-contorno-escuro {
  border-color: rgba(23, 20, 22, 0.35);
  color: var(--preto);
}
.botao-contorno-escuro:hover {
  border-color: var(--vinho);
  color: var(--vinho);
}

.botoes {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}

/* ---------- Imagens com selo "Foto provisória" ---------- */

.foto {
  position: relative;
  overflow: hidden;
  background: #2a2427;
}

.foto img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.foto-arco {
  border-radius: var(--arco);
}

.selo-provisoria {
  position: absolute;
  right: 0.75rem;
  bottom: 0.75rem;
  padding: 0.3rem 0.65rem;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--preto);
  background: var(--champagne);
  border-radius: 999px;
  pointer-events: none;
}

/* ---------- Cabeçalho ---------- */

.cabecalho {
  position: fixed;
  inset: 0 0 auto 0;
  z-index: 50;
  color: var(--off-white);
  background: rgba(23, 20, 22, 0.94);
  border-bottom: 1px solid var(--linha-clara);
  transition: background-color var(--transicao), border-color var(--transicao);
}

/* Na Home, o cabeçalho começa transparente sobre o Hero */
.pagina-home .cabecalho:not(.rolado) {
  background: transparent;
  border-bottom-color: transparent;
}

.cabecalho-interno {
  display: flex;
  align-items: center;
  gap: 2rem;
  height: var(--altura-cabecalho);
}

.marca {
  display: flex;
  align-items: baseline;
  gap: 0.45rem;
  margin-right: auto;
  line-height: 1;
  text-decoration: none;
}

.marca-nome {
  font-family: var(--fonte-titulo);
  font-size: 1.4rem;
  font-weight: 700;
  letter-spacing: -0.03em;
}

.marca-sub {
  font-size: 0.85rem;
  color: var(--champagne);
}

.menu {
  display: flex;
  gap: 2rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.menu a {
  position: relative;
  padding-block: 0.4rem;
  font-size: 0.95rem;
  color: var(--texto-claro-suave);
  text-decoration: none;
  transition: color var(--transicao);
}

.menu a:hover,
.menu a[aria-current='page'] {
  color: var(--off-white);
}

.menu a[aria-current='page']::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -6px;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--champagne);
  transform: translateX(-50%);
}

.cabecalho-whatsapp {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.6rem 1.15rem;
  border-radius: 999px;
  background: var(--vinho);
  color: var(--off-white);
  font-size: 0.9rem;
  font-weight: 600;
  text-decoration: none;
}

.cabecalho-whatsapp:hover {
  background: var(--vinho-escuro);
}

.cabecalho-whatsapp svg {
  width: 17px;
  height: 17px;
}

.botao-menu {
  display: none;
  width: 46px;
  height: 46px;
  margin-right: -10px;
  padding: 0;
  background: none;
  border: 0;
  cursor: pointer;
}

.botao-menu-linhas {
  position: relative;
  display: block;
  width: 26px;
  height: 10px;
  margin: auto;
}

.botao-menu-linhas span {
  position: absolute;
  left: 0;
  width: 100%;
  height: 1.5px;
  background: currentColor;
  transition: transform var(--transicao), top var(--transicao);
}

.botao-menu-linhas span:first-child {
  top: 0;
}
.botao-menu-linhas span:last-child {
  top: 9px;
}

.botao-menu[aria-expanded='true'] span:first-child {
  top: 4.5px;
  transform: rotate(45deg);
}
.botao-menu[aria-expanded='true'] span:last-child {
  top: 4.5px;
  transform: rotate(-45deg);
}

/* Menu do celular */
.menu-celular {
  position: fixed;
  inset: var(--altura-cabecalho) 0 0 0;
  z-index: 49;
  padding-block: 3rem;
  overflow-y: auto;
  background: var(--preto);
  color: var(--off-white);
}

.menu-celular[hidden] {
  display: none;
}

.menu-celular ul {
  margin: 0 0 3rem;
  padding: 0;
  list-style: none;
  border-top: 1px solid var(--linha-clara);
}

.menu-celular li {
  border-bottom: 1px solid var(--linha-clara);
}

.menu-celular ul a {
  display: block;
  padding-block: 1.1rem;
  font-family: var(--fonte-titulo);
  font-size: 2rem;
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.1;
  color: var(--texto-claro-suave);
  text-decoration: none;
}

.menu-celular ul a[aria-current='page'] {
  color: var(--off-white);
}

.menu-celular-local {
  margin-top: 2rem;
  font-size: 0.875rem;
  color: var(--cinza);
}

body.menu-aberto .cabecalho {
  background: var(--preto);
}

@media (max-width: 900px) {
  .menu,
  .cabecalho-whatsapp {
    display: none;
  }
  .botao-menu {
    display: inline-flex;
    align-items: center;
  }
}

/* ---------- Botão flutuante do WhatsApp ---------- */

.whatsapp-flutuante {
  position: fixed;
  right: clamp(1rem, 3vw, 2rem);
  bottom: clamp(1rem, 3vw, 2rem);
  z-index: 40;
  display: grid;
  place-items: center;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--vinho);
  color: var(--off-white);
  border: 1px solid rgba(215, 192, 160, 0.35);
  box-shadow: 0 8px 24px rgba(23, 20, 22, 0.28);
  transition: background-color var(--transicao), transform var(--transicao);
}

.whatsapp-flutuante:hover {
  background: var(--vinho-escuro);
  transform: translateY(-2px);
}

.whatsapp-flutuante svg {
  width: 24px;
  height: 24px;
}

/* ---------- Rodapé ---------- */

.rodape {
  padding-top: 4.5rem;
  background: var(--preto);
  color: var(--texto-claro-suave);
  font-size: 0.95rem;
}

.rodape-grade {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 3rem;
  padding-bottom: 3rem;
}

.rodape-marca {
  font-family: var(--fonte-titulo);
  font-size: var(--titulo-medio);
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.1;
  color: var(--off-white);
}

.rodape-grade p + p {
  margin-top: 0.5rem;
}

.rodape ul {
  display: grid;
  gap: 0.6rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.rodape ul a {
  text-decoration: none;
}

.rodape ul a:hover {
  color: var(--champagne);
}

.rodape-final {
  padding-block: 1.5rem;
  border-top: 1px solid var(--linha-clara);
  font-size: 0.875rem;
  color: var(--cinza);
}

@media (max-width: 760px) {
  .rodape-grade {
    grid-template-columns: 1fr 1fr;
  }
  .rodape-grade > div:first-child {
    grid-column: 1 / -1;
  }
}

/* =========================================================
   HOME
   ========================================================= */

.hero {
  position: relative;
  display: flex;
  align-items: center;
  min-height: max(640px, 92vh);
  min-height: max(640px, 92svh);
  padding-top: calc(var(--altura-cabecalho) + 2rem);
  padding-bottom: 4.5rem;
  background:
    radial-gradient(ellipse 60% 70% at 78% 40%, rgba(87, 29, 50, 0.45), transparent 70%),
    var(--preto);
  color: var(--off-white);
  overflow: hidden;
}

.hero-grade {
  display: grid;
  grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
  align-items: center;
  gap: clamp(2rem, 5vw, 5rem);
}

.local {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  margin-bottom: 1.5rem;
  font-size: 0.95rem;
  color: var(--champagne);
}

.local svg {
  width: 16px;
  height: 16px;
}

.hero-titulo {
  font-size: clamp(2.3rem, 1.2rem + 2.9vw, 3.9rem);
  line-height: 1.02;
  letter-spacing: -0.025em;
}

.hero-titulo span {
  display: block;
  animation: subir 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

/* Recuo editorial: a segunda frase responde à primeira */
.hero-titulo span + span {
  margin-top: 0.12em;
  padding-left: clamp(1rem, 4vw, 3.5rem);
  font-weight: 300;
  color: var(--champagne);
  animation-delay: 160ms;
}

.hero-texto {
  max-width: 34rem;
  margin-top: 2rem;
  font-size: var(--texto-grande);
  line-height: 1.55;
  color: var(--texto-claro-suave);
  animation: subir 900ms cubic-bezier(0.22, 1, 0.36, 1) 300ms both;
}

.hero .botoes {
  margin-top: 2rem;
  animation: subir 900ms cubic-bezier(0.22, 1, 0.36, 1) 420ms both;
}

.hero-foto {
  position: relative;
  justify-self: end;
  width: min(100%, 440px);
  max-height: 74vh;
  aspect-ratio: 3 / 4;
  margin: 0;
}

.hero-foto .foto {
  height: 100%;
  animation: revelar 1300ms cubic-bezier(0.22, 1, 0.36, 1) 120ms both;
}

/* Contorno em arco atrás da foto */
.hero-foto::before {
  content: '';
  position: absolute;
  inset: -18px 18px 18px -18px;
  border: 1px solid rgba(215, 192, 160, 0.5);
  border-radius: var(--arco);
}

.indicador-rolagem {
  position: absolute;
  left: 50%;
  bottom: 1.5rem;
  width: 24px;
  height: 56px;
  transform: translateX(-50%);
}

.indicador-rolagem span {
  position: absolute;
  left: 50%;
  top: 0;
  width: 1px;
  height: 100%;
  background: linear-gradient(to bottom, transparent, var(--champagne));
  transform-origin: top;
  animation: escorrer 2.4s cubic-bezier(0.22, 1, 0.36, 1) infinite;
}

@keyframes subir {
  from {
    opacity: 0;
    transform: translateY(24px);
  }
}

@keyframes revelar {
  from {
    clip-path: inset(100% 0 0 0 round 999px 999px 18px 18px);
  }
  to {
    clip-path: inset(0 0 0 0 round 999px 999px 18px 18px);
  }
}

@keyframes escorrer {
  0% {
    transform: scaleY(0);
    opacity: 1;
  }
  70% {
    transform: scaleY(1);
    opacity: 1;
  }
  100% {
    opacity: 0;
  }
}

@media (max-width: 900px) {
  .hero {
    min-height: auto;
    padding-top: calc(var(--altura-cabecalho) + 1.5rem);
    padding-bottom: var(--espaco-secao);
  }
  .hero-grade {
    grid-template-columns: 1fr;
  }
  .hero-foto {
    order: -1;
    justify-self: center;
    width: min(78%, 340px);
    max-height: none;
    margin-top: 1rem;
  }
  .hero-foto::before {
    inset: -12px 12px 12px -12px;
  }
}

/* ---------- Seguidores ---------- */

.seguidores {
  padding-block: var(--espaco-secao);
  background: var(--vinho);
  color: var(--off-white);
  overflow: hidden;
}

.seguidores-grade {
  display: grid;
  grid-template-columns: auto minmax(0, 26rem);
  align-items: end;
  justify-content: space-between;
  gap: 3rem;
}

.seguidores-numero {
  font-family: var(--fonte-titulo);
  font-size: clamp(5rem, 2rem + 14vw, 15rem);
  font-weight: 300;
  line-height: 0.85;
  letter-spacing: -0.06em;
  white-space: nowrap;
}

.seguidores h2 {
  font-size: var(--titulo-medio);
  line-height: 1.15;
}

.seguidores p {
  margin-block: 1.5rem 2rem;
  color: rgba(243, 238, 231, 0.78);
}

@media (max-width: 900px) {
  .seguidores-grade {
    grid-template-columns: 1fr;
    align-items: start;
  }
}

/* ---------- Trabalhos selecionados ---------- */

.trabalhos {
  padding-block: var(--espaco-secao);
}

.secao-topo {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
  align-items: end;
  gap: 2rem;
  margin-bottom: 3rem;
}

.secao-topo h2 {
  font-size: var(--titulo-grande);
}

.secao-topo p {
  color: var(--texto-escuro-suave);
}

.secao-rodape {
  display: flex;
  justify-content: center;
  margin-top: 3rem;
}

/* Grade assimétrica da Home (5 fotos) */
.grade-destaque {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  grid-auto-rows: clamp(150px, 17vw, 230px);
  gap: clamp(0.75rem, 1.6vw, 1.25rem);
  margin: 0;
  padding: 0;
  list-style: none;
}

.grade-destaque li:nth-child(1) {
  grid-column: 1 / span 5;
  grid-row: span 3;
}
.grade-destaque li:nth-child(2) {
  grid-column: 6 / span 4;
  grid-row: span 2;
}
.grade-destaque li:nth-child(3) {
  grid-column: 10 / span 3;
  grid-row: span 2;
}
.grade-destaque li:nth-child(4) {
  grid-column: 6 / span 3;
}
.grade-destaque li:nth-child(5) {
  grid-column: 9 / span 4;
}

.grade-destaque .trabalho,
.grade-destaque .trabalho .foto {
  height: 100%;
}

/* Card de trabalho (link que abre a foto ampliada) */
.trabalho {
  display: block;
  border-radius: 6px;
  overflow: hidden;
  cursor: zoom-in;
}

.trabalho img {
  transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
}

.trabalho:hover img,
.trabalho:focus-visible img {
  transform: scale(1.035);
}

@media (max-width: 760px) {
  .secao-topo {
    grid-template-columns: 1fr;
  }
  .grade-destaque {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 42vw;
  }
  .grade-destaque li:nth-child(n) {
    grid-column: auto;
    grid-row: span 1;
  }
  .grade-destaque li:nth-child(1) {
    grid-column: 1 / -1;
    grid-row: span 2;
  }
}

/* ---------- Manifesto ---------- */

.manifesto {
  padding-block: var(--espaco-secao);
  background: var(--preto);
  color: var(--off-white);
}

.manifesto-grade {
  display: grid;
  grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
  align-items: center;
  gap: clamp(2.5rem, 7vw, 7rem);
}

.manifesto .foto {
  width: min(100%, 420px);
  aspect-ratio: 4 / 5;
}

.manifesto h2 {
  max-width: 15ch;
  font-size: var(--titulo-grande);
  line-height: 1.06;
}

.manifesto-texto {
  display: grid;
  gap: 1.5rem;
  max-width: 34rem;
  margin-top: 3rem;
  padding-left: 2rem;
  border-left: 1px solid var(--vinho);
  color: var(--texto-claro-suave);
  line-height: 1.7;
}

.manifesto-fecho {
  font-family: var(--fonte-titulo);
  font-size: var(--texto-grande);
  font-weight: 500;
  line-height: 1.45;
  color: var(--champagne);
}

@media (max-width: 900px) {
  .manifesto-grade {
    grid-template-columns: 1fr;
  }
  .manifesto .foto {
    width: min(70%, 320px);
  }
  .manifesto-texto {
    padding-left: 1.5rem;
  }
}

/* ---------- Chamada final ---------- */

.chamada {
  position: relative;
  padding-block: var(--espaco-secao);
  overflow: hidden;
  text-align: center;
}

/* Arco gigante em linha fina ao fundo */
.chamada::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 14%;
  width: min(70vw, 620px);
  height: 140%;
  border: 1px solid rgba(87, 29, 50, 0.18);
  border-radius: 999px 999px 0 0;
  transform: translateX(-50%);
}

.chamada .container {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.chamada h2 {
  max-width: 13ch;
  font-size: var(--titulo-gigante);
  line-height: 1.02;
}

.chamada p {
  max-width: 32rem;
  margin-top: 2rem;
  font-size: var(--texto-grande);
  line-height: 1.5;
  color: var(--texto-escuro-suave);
}

.chamada .botoes {
  justify-content: center;
  margin-top: 3rem;
}

/* =========================================================
   PÁGINAS INTERNAS
   ========================================================= */

.abertura {
  padding-top: calc(var(--altura-cabecalho) + 4.5rem);
  padding-bottom: 4.5rem;
  background:
    radial-gradient(ellipse 50% 90% at 90% 0%, rgba(87, 29, 50, 0.5), transparent 70%),
    var(--preto);
  color: var(--off-white);
}

.abertura h1 {
  max-width: 16ch;
  font-size: var(--titulo-gigante);
  animation: subir 800ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.abertura p {
  max-width: 38rem;
  margin-top: 1.5rem;
  font-size: var(--texto-grande);
  line-height: 1.55;
  color: var(--texto-claro-suave);
  animation: subir 800ms cubic-bezier(0.22, 1, 0.36, 1) 140ms both;
}

/* ---------- Minha História ---------- */

.historia {
  padding-block: var(--espaco-secao);
}

.etapas {
  display: grid;
  gap: var(--espaco-secao);
  margin: 0 auto;
  list-style: none;
}

.etapa {
  display: grid;
  grid-template-columns: 5rem minmax(0, 1fr);
  gap: 2rem;
  align-items: start;
}

.etapa-com-foto {
  grid-template-columns: 5rem minmax(0, 1.1fr) minmax(0, 0.9fr);
  align-items: center;
}

.etapa-numero {
  font-family: var(--fonte-titulo);
  font-size: clamp(3.5rem, 2rem + 4vw, 5.5rem);
  font-weight: 300;
  letter-spacing: -0.05em;
  line-height: 0.9;
  color: var(--vinho);
}

.etapa-texto {
  display: grid;
  gap: 1rem;
  max-width: 36rem;
  color: var(--texto-escuro-suave);
  line-height: 1.75;
}

.etapa-texto h2 {
  margin-bottom: 0.5rem;
  font-size: var(--titulo-medio);
  color: var(--preto);
}

.etapa .foto {
  justify-self: center;
  width: min(100%, 340px);
  aspect-ratio: 4 / 5;
}

/* Etapa com a foto do lado esquerdo */
.etapa-invertida {
  grid-template-columns: 5rem minmax(0, 0.9fr) minmax(0, 1.1fr);
}
.etapa-invertida .foto {
  grid-column: 2;
  grid-row: 1;
}
.etapa-invertida .etapa-texto {
  grid-column: 3;
  grid-row: 1;
}

.historia-fim {
  padding-block: var(--espaco-secao);
  background: var(--vinho);
  color: var(--off-white);
}

.historia-fim .container {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
}

.historia-fim h2 {
  max-width: 16ch;
  font-size: var(--titulo-grande);
}

@media (max-width: 900px) {
  .etapa,
  .etapa-com-foto,
  .etapa-invertida {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .etapa-invertida .foto,
  .etapa-invertida .etapa-texto {
    grid-column: auto;
    grid-row: auto;
  }
  .etapa .foto {
    justify-self: start;
    width: min(70%, 300px);
  }
}

/* ---------- Portfólio ---------- */

.galeria {
  padding-block: 4.5rem 3rem;
}

/* Grade uniforme 4:5 com a coluna do meio deslocada para baixo */
.grade-galeria {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(1rem, 2.4vw, 2rem);
  margin: 0;
  padding: 0 0 4.5rem;
  list-style: none;
}

.grade-galeria .foto {
  aspect-ratio: 4 / 5;
}

.grade-galeria li:nth-child(3n + 2) {
  transform: translateY(4.5rem);
}

.galeria-instagram {
  padding-block: 3rem var(--espaco-secao);
}

.galeria-instagram .container {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
}

.galeria-instagram .linha {
  width: 100%;
  border-top: 1px solid var(--linha-escura);
  margin-bottom: 1.5rem;
}

.galeria-instagram p {
  max-width: 24ch;
  font-family: var(--fonte-titulo);
  font-size: var(--titulo-medio);
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.2;
}

@media (max-width: 760px) {
  .grade-galeria {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding-bottom: 3rem;
  }
  .grade-galeria li:nth-child(3n + 2) {
    transform: none;
  }
  .grade-galeria li:nth-child(2n) {
    transform: translateY(3rem);
  }
}

/* ---------- Contato ---------- */

.contato {
  display: flex;
  align-items: center;
  min-height: 100svh;
  padding-top: calc(var(--altura-cabecalho) + 3rem);
  padding-bottom: var(--espaco-secao);
  background:
    radial-gradient(ellipse 55% 80% at 85% 60%, rgba(87, 29, 50, 0.5), transparent 70%),
    var(--preto);
  color: var(--off-white);
}

.contato-grade {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
  align-items: center;
  gap: clamp(2.5rem, 7vw, 6rem);
}

.contato h1 {
  max-width: 14ch;
  font-size: var(--titulo-gigante);
}

.contato-bio {
  max-width: 34rem;
  margin-top: 2rem;
  font-size: var(--texto-grande);
  line-height: 1.55;
}

.contato-convite {
  max-width: 34rem;
  margin-top: 1rem;
  color: var(--texto-claro-suave);
}

.contato-canais {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1.5rem 2rem;
  margin-top: 3rem;
}

.contato-canais .botao {
  min-height: 60px;
  padding-inline: 2rem;
  font-size: 1.05rem;
}

.contato-instagram {
  display: inline-flex;
  align-items: center;
  gap: 0.8rem;
  line-height: 1.3;
  text-decoration: none;
}

.contato-instagram svg {
  width: 20px;
  height: 20px;
}

.contato-instagram small {
  display: block;
  font-size: 0.875rem;
  color: var(--cinza);
}

.contato-instagram strong {
  border-bottom: 1px solid transparent;
}

.contato-instagram:hover strong {
  border-bottom-color: var(--champagne);
}

.contato .foto {
  justify-self: end;
  width: min(100%, 380px);
  aspect-ratio: 3 / 4;
}

@media (max-width: 900px) {
  .contato-grade {
    grid-template-columns: 1fr;
  }
  .contato .foto {
    justify-self: start;
    width: min(60%, 260px);
  }
}

/* ---------- Seja parceiro ---------- */

.parceiro {
  padding-block: var(--espaco-secao);
}

.parceiro-grade {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
  align-items: stretch;
  gap: clamp(2.5rem, 6vw, 5rem);
}

.canais {
  display: grid;
  align-content: start;
  margin: 0;
  padding: 0;
  list-style: none;
  border-top: 1px solid var(--linha-escura);
}

.canal {
  display: grid;
  grid-template-columns: 56px minmax(0, 1fr);
  gap: 1.25rem;
  padding-block: 2rem;
  border-bottom: 1px solid var(--linha-escura);
}

.canal-icone {
  display: grid;
  place-items: center;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--vinho);
  color: var(--off-white);
}

.canal-icone svg {
  width: 24px;
  height: 24px;
}

.canal-texto h2 {
  font-size: 1.25rem;
  letter-spacing: -0.02em;
}

.canal-texto p {
  margin-top: 0.35rem;
  color: var(--texto-escuro-suave);
  font-variant-numeric: tabular-nums;
}

.canal-link {
  display: inline-block;
  margin-top: 0.75rem;
  font-weight: 600;
  color: var(--vinho);
  text-decoration: underline;
  text-decoration-color: rgba(87, 29, 50, 0.35);
  text-underline-offset: 4px;
  transition: text-decoration-color var(--transicao);
}

.canal-link:hover {
  text-decoration-color: var(--vinho);
}

/* Mapa com o mesmo arco das fotos */
.mapa {
  min-height: 480px;
  overflow: hidden;
  border-radius: var(--arco);
  background: #e6dfd5;
}

.mapa iframe {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 480px;
  border: 0;
}

@media (max-width: 900px) {
  .parceiro-grade {
    grid-template-columns: 1fr;
  }
  .mapa,
  .mapa iframe {
    min-height: 380px;
  }
  .mapa {
    border-radius: 200px 200px 18px 18px;
  }
}

/* ---------- Página 404 ---------- */

.abertura .botoes {
  margin-top: 2rem;
}

/* =========================================================
   FOTO AMPLIADA (criada pelo js/main.js)
   ========================================================= */

.ampliada {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: grid;
  grid-template-rows: auto 1fr;
  background: rgba(16, 13, 15, 0.985);
  color: var(--off-white);
  animation: aparecer 240ms ease-out;
}

.ampliada[hidden] {
  display: none;
}

.ampliada-topo {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem var(--margem);
}

.ampliada-contador {
  font-size: 0.875rem;
  color: var(--texto-claro-suave);
  font-variant-numeric: tabular-nums;
}

.ampliada-palco {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  min-height: 0;
  margin: 0;
  padding: 0 clamp(1rem, 8vw, 6.5rem) 2rem;
}

.ampliada-palco img {
  max-width: 100%;
  max-height: calc(100svh - 170px);
  width: auto;
  height: auto;
  object-fit: contain;
  border-radius: 6px;
}

.ampliada-legenda {
  font-size: 0.875rem;
  color: var(--champagne);
  text-align: center;
}

.ampliada-botao {
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  padding: 0;
  border: 1px solid var(--linha-clara);
  border-radius: 50%;
  background: rgba(23, 20, 22, 0.6);
  color: var(--off-white);
  cursor: pointer;
}

.ampliada-botao:hover {
  border-color: var(--champagne);
  color: var(--champagne);
}

.ampliada-botao svg {
  width: 22px;
  height: 22px;
}

.ampliada-anterior,
.ampliada-proxima {
  position: fixed;
  top: 50%;
  transform: translateY(-50%);
}

.ampliada-anterior {
  left: var(--margem);
}
.ampliada-proxima {
  right: var(--margem);
}

@keyframes aparecer {
  from {
    opacity: 0;
  }
}

@media (max-width: 640px) {
  .ampliada-palco {
    padding-inline: 1rem;
    padding-bottom: 88px;
  }
  .ampliada-palco img {
    max-height: calc(100svh - 200px);
  }
  .ampliada-anterior,
  .ampliada-proxima {
    top: auto;
    bottom: 1.5rem;
    transform: none;
  }
}

/* Respeita quem prefere menos movimento */
@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* Retrato no Hero: mantém o rosto visível dentro do arco */
.hero-foto img {
  object-position: 50% 12%;
}

/* Endereço com link para o mapa */
a.local,
.menu-celular-local,
.rodape-grade p a {
  text-decoration: none;
  text-underline-offset: 3px;
}

a.local:hover,
.menu-celular-local:hover,
.rodape-grade p a:hover {
  text-decoration: underline;
}

.menu-celular-local {
  display: block;
}

.local svg {
  flex-shrink: 0;
}
